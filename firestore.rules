rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Campos de cobrança e reputação: só o admin (painel /admin) grava.
    // O projeto roda sem Cloud Functions, então o admin ativa planos à mão
    // depois do PIX. O dono pode apenas voltar para o plano Free (sem
    // destaque) e marcar crmvVerified como false; nunca se promover.
    function adminOnlyUserKeys() {
      return ['planCoupon', 'planPaidUntil', 'averageRating', 'ratingCount',
              'paidVisits', 'fundador', 'fundadorTrialEndedAt'];
    }
    function userWriteIsSafe(data, changed) {
      return !changed.hasAny(adminOnlyUserKeys())
        && (!changed.hasAny(['plan', 'featured', 'planActivatedAt'])
            || (data.get('plan', 'free') == 'free' && data.get('featured', false) == false))
        && (!changed.hasAny(['crmvVerified']) || data.crmvVerified == false);
    }

    // Users: qualquer autenticado lê (perfil público do vet); o dono
    // escreve no seu documento sem tocar nos campos acima; o admin pode
    // atualizar qualquer um (ativar plano, Vet Fundador, mensalidade paga).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && userWriteIsSafe(request.resource.data, request.resource.data.keys());
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && userWriteIsSafe(request.resource.data,
                               request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;
    }

    // Pedidos de plano (Vet Fundador ou assinatura): o vet cria e acompanha
    // o próprio; o admin lê todos e marca como atendido.
    match /plan_requests/{userId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.status == 'pendente';
      allow update, delete: if isAdmin();
    }

    // Professionals: authenticated users can read; only the professional can write their own document
    match /professionals/{professionalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == professionalId;
    }

    // Email Index: authenticated users can read; any authenticated user can write (used for lookup)
    match /email_index/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Private subcollection: só o próprio usuário acessa (CPF, data de nascimento, etc.)
    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pets: só o dono cadastra/edita/exclui
    match /users/{userId}/pets/{petId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Registros clínicos: dono lê/escreve; veterinário autenticado pode adicionar
    match /users/{userId}/pets/{petId}/records/{recordId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Ratings: authenticated users can read any rating; only the client who made the rating can write
    match /users/{userId}/ratings/{ratingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == request.resource.data.clientId || request.auth.uid == userId);
    }

    // Requests: o cliente cria com clientId == seu uid; apenas o cliente
    // OU o veterinário designado podem ler e atualizar a solicitação.
    match /requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow read, update: if request.auth != null
        && (resource.data.clientId == request.auth.uid
            || resource.data.professionalId == request.auth.uid);
      // Admin lê para contar atendimentos pagos dos Vets Fundadores
      allow read: if isAdmin();
      allow delete: if false;
    }

    // Appointments: only the designated professional can create an appointment for themselves;
    // client or professional can read an appointment
    // additionally allow the assigned professional (or the client) to update the appointment
    match /appointments/{appointmentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Chats: one chat doc per request, with a messages subcollection.
    // Any authenticated user can read/create the chat doc; messages can only be
    // created by their own sender (senderId must match the caller).
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      // Apagar chat expirado: só quem participa da conversa
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId;
        // Apagar mensagens (limpeza de chat expirado)
        allow delete: if request.auth != null;
      }
    }

    // Admins: só o próprio admin pode ler seu doc (usado para verificar acesso ao painel)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // só via console do Firebase
    }

    // Offers: admin lê/escreve; clientes autenticados só leem
    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Config (plans, coupons, etc.): todos autenticados leem; só admin escreve
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Uso de cupons: só Cloud Functions (via admin SDK)
    match /coupon_redemptions/{id} {
      allow read, write: if false;
    }

    // Payments: usuário lê os próprios; só Cloud Functions escrevem (via admin SDK)
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Default: deny everything else
  }
}
