rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin do app: documento em admins/{uid}. Usado para liberar
    // leituras agregadas do painel /admin (nunca escrita de dados alheios).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Papéis gravados pelo app. O cadastro do veterinário grava
    // 'medico_veterinario' (ConfirmDataPage) e o do tutor grava 'client'
    // (UserTypePage) — nenhum outro valor é escrito em lugar nenhum.
    // 'vet' e 'professional' ficam aceitos só por compatibilidade com
    // contas antigas.
    function ehVet(p) {
      return p in ['medico_veterinario', 'vet', 'professional'];
    }

    // Veterinário cadastrado. Usado para dar acesso clínico (pets e
    // prontuário) a quem atende — nunca a clientes de outras contas.
    function isVetUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ehVet(get(/databases/$(database)/documents/users/$(request.auth.uid))
                   .data.get('profession', ''));
    }

    // Campos que o próprio usuário NUNCA pode escrever no seu documento:
    //  - averageRating/ratingCount: é a nota que o cliente vê na busca.
    //    Sem isto o veterinário se dava 5,0 e ia para o topo.
    //  - disabled: senão a conta desativada pelo admin se reativa sozinha.
    function camposProtegidosIntactos() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['averageRating', 'ratingCount', 'disabled']);
    }

    // Plano pago só o servidor ativa (pagamento confirmado ou cupom).
    // Antes, o próprio usuário gravava plan: 'premium' no perfil e ganhava
    // o Destaque sem pagar. O dono pode apenas voltar para o Free.
    function planoIntacto() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return !mudou.hasAny(['plan', 'featured', 'planExpiresAt', 'planActivatedAt',
                            'planCheckoutId', 'planPeriodo', 'planCoupon'])
        || (request.resource.data.get('plan', 'free') == 'free'
            && request.resource.data.get('featured', false) == false
            && !mudou.hasAny(['planExpiresAt', 'planCheckoutId', 'planPeriodo', 'planCoupon']));
    }

    // Vet Fundador: a vaga, a contagem de atendimentos e o fim do período
    // grátis só o servidor grava. Senão o vet zerava a própria contagem e
    // ficava no Premium grátis para sempre.
    function fundadorIntacto() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['fundador', 'fundadorTrialEndedAt', 'paidVisits']);
    }

    // CPF da conta (cpfHash): gravado uma única vez, no MESMO lote que cria
    // a reserva em cpfs/{hash} com o uid desta conta. Depois não muda pelo
    // app: trocar deixaria "soltar" um CPF e reservar o de outra pessoa.
    function cpfHashIntacto() {
      let antes = resource.data.get('cpfHash', null);
      let depois = request.resource.data.get('cpfHash', null);
      return antes == depois
        || (antes == null
            && depois is string
            && existsAfter(/databases/$(database)/documents/cpfs/$(depois))
            && getAfter(/databases/$(database)/documents/cpfs/$(depois)).data.uid == request.auth.uid);
    }

    // Users: o próprio dono e o admin sempre leem. O perfil do
    // veterinário é público (a busca do cliente depende disso), mas o
    // documento de um CLIENTE só é visível para ele, para o admin e
    // para veterinários — sem isso qualquer pessoa que criasse uma
    // conta varria nome e e-mail de toda a base.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || isAdmin()
            || ehVet(resource.data.get('profession', ''))
            || isVetUser());

      // Conta nova nasce no Free: sem isto, bastava criar o próprio
      // documento já com plan: 'premium'.
      allow create: if request.auth != null
        && (isAdmin()
            || (request.auth.uid == userId
                && request.resource.data.get('plan', 'free') == 'free'
                && request.resource.data.get('featured', false) == false
                && !request.resource.data.keys()
                      .hasAny(['fundador', 'fundadorTrialEndedAt', 'paidVisits'])));
      allow update: if request.auth != null
        && (isAdmin()
            || (request.auth.uid == userId && camposProtegidosIntactos()
                && cpfHashIntacto() && planoIntacto() && fundadorIntacto()));
      allow delete: if isAdmin();
    }

    // Professionals: coleção legada, só leitura de perfil público.
    match /professionals/{professionalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == professionalId;
    }

    // Email Index: nenhuma tela do app lê ou escreve esta coleção.
    // Enquanto estava aberta, qualquer autenticado podia sobrescrever a
    // entrada de outra pessoa. Fechada até existir um uso real.
    match /email_index/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Private subcollection: só o próprio usuário acessa (CPF, data de nascimento, etc.)
    match /users/{userId}/private/{docId} {
      // O admin lê apenas para conseguir varrer e apagar na exclusão da
      // conta — uma listagem precisa de permissão de leitura.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Configurações do usuário (ex: settings/availability — os horários
    // de atendimento do veterinário). O dono escreve; qualquer
    // autenticado lê, porque o cliente precisa dos horários livres do
    // vet para montar a tela de agendamento.
    match /users/{userId}/settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();   // exclusão em cascata da conta
    }

    // Pets: só o dono cadastra/edita/exclui. Veterinários leem (precisam
    // dos dados do animal para abrir o prontuário durante o atendimento).
    match /users/{userId}/pets/{petId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isVetUser() || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Registros clínicos: dono lê/escreve; veterinário autenticado pode adicionar
    match /users/{userId}/pets/{petId}/records/{recordId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isVetUser() || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Ratings: qualquer autenticado lê (a nota é pública), mas quem
    // escreve é somente o CLIENTE autor — e nunca o próprio avaliado.
    // Antes, `request.auth.uid == userId` deixava o veterinário criar
    // notas sobre si mesmo e sobrescrever as ruins.
    match /users/{userId}/ratings/{ratingId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid != userId
        && request.auth.uid == request.resource.data.clientId;

      // Corrigir a própria avaliação é permitido; trocar de autor não.
      allow update: if request.auth != null
        && request.auth.uid != userId
        && request.auth.uid == resource.data.clientId
        && request.resource.data.clientId == resource.data.clientId;

      allow delete: if isAdmin();
    }

    // Referrals (indicações): o dono (indicador) lê as suas. Quem cria a
    // indicação é o próprio indicado, no ato do cadastro — por isso o id
    // do documento é o uid dele. Antes qualquer autenticado escrevia na
    // subárvore de qualquer usuário, e a indicação credita plano.
    match /users/{userId}/referrals/{refId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // A entrada nasce sem plano: ninguém se cadastra já creditando o
      // colega. E ninguém indica a si mesmo.
      allow create: if request.auth != null
        && request.auth.uid == refId
        && request.auth.uid != userId
        && request.resource.data.get('activatedPlan', null) == null;
      // Depois, o indicado só marca a ativação do plano.
      allow update: if request.auth != null
        && request.auth.uid == refId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activatedPlan', 'activatedAt', 'viaCupom']);
      allow delete: if isAdmin();
    }

    // Um CPF, uma conta. O id é o SHA-256 dos 11 dígitos, nunca o CPF.
    //  - create recusa documento existente (vira update): é a trava do
    //    segundo cadastro com o mesmo CPF;
    //  - a conta só reserva se ainda não tinha CPF, e no mesmo lote grava o
    //    hash no próprio users/{uid}. Sem isso, alguém reservava os CPFs de
    //    outras pessoas e as impedia de se cadastrar.
    //  - ninguém lista nem lê a reserva alheia (diria quem tem conta).
    match /cpfs/{hash} {
      allow get: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null
        && hash.matches('^[a-f0-9]{64}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'criadoEm'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('cpfHash', null) == null
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('cpfHash', null) == hash;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Códigos de indicação: código -> uid de quem indica.
    // Existe porque achar o indicador consultando users por referralCode
    // era recusado pelas regras para quem acabou de criar a conta (a
    // consulta não prova que só devolve veterinários). Aqui é leitura
    // direta de UM documento, e o perfil de ninguém fica exposto.
    match /referralCodes/{code} {
      allow get: if request.auth != null;
      // Listar daria a lista de quem indica. Só o admin.
      allow list: if isAdmin();
      // Cada um reserva o próprio código. Se o código já existe, isto
      // vira update e é recusado: é o que garante código único.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && code.matches('^[A-Z0-9]{4,12}$');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Requests: o cliente cria com clientId == seu uid.
    // Leitura/atualização: o cliente dono, o veterinário designado, OU
    // qualquer VETERINÁRIO autenticado quando a solicitação é uma
    // EMERGÊNCIA ainda em aberto (status 'urgente' e sem professionalId).
    // O recorte por veterinário é essencial: a emergência carrega nome,
    // telefone, endereço e coordenadas do cliente.
    match /requests/{requestId} {
      // O cliente aprova o orçamento escrevendo em quote.approvedAt, então
      // `quote` precisa continuar gravável por ele — mas o VALOR não, senão
      // dava para zerar o total depois do atendimento feito.
      function totalDoOrcamentoIntacto() {
        return !('quote' in resource.data)
          || request.resource.data.get('quote', {}).get('total', 0)
             == resource.data.get('quote', {}).get('total', 0);
      }
      // Cada lado só marca o que é seu: a confirmação de que o atendimento
      // aconteceu é do CLIENTE (é ela que conta para o Vet Fundador), e o
      // "recebi o pagamento" é do VET. O vet só pode zerar a confirmação
      // (é o que acontece ao finalizar).
      function vetNaoConfirmaPeloCliente() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmFinish_client'])
          || request.resource.data.confirmFinish_client == false;
      }
      function clienteNaoMarcaPagamento() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['paymentReceived', 'paymentReceivedAt']);
      }
      function clienteNaoTrocaAsPartes() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['clientId', 'professionalId', 'professionalName']);
      }

      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;

      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
            || resource.data.professionalId == request.auth.uid
            || isAdmin()
            || (resource.data.status == 'urgente'
                && !('professionalId' in resource.data)
                && isVetUser()));

      allow update: if request.auth != null
        && (isAdmin()          // moderação pelo painel (devolver à fila)
            || (resource.data.clientId == request.auth.uid
                && clienteNaoTrocaAsPartes()
                && totalDoOrcamentoIntacto()
                && clienteNaoMarcaPagamento())
            || (resource.data.professionalId == request.auth.uid
                && vetNaoConfirmaPeloCliente())
            || (resource.data.status == 'urgente'
                && !('professionalId' in resource.data)
                && isVetUser()
                && request.resource.data.professionalId == request.auth.uid));

      allow delete: if isAdmin();
    }

    // Appointments: só as duas partes do atendimento (cliente e
    // veterinário) leem/escrevem. Antes qualquer autenticado lia e
    // alterava QUALQUER agendamento da plataforma.
    match /appointments/{appointmentId} {
      allow create: if request.auth != null
        && (request.resource.data.professionalId == request.auth.uid
            || request.resource.data.clientId == request.auth.uid);
      allow read, update: if request.auth != null
        && (resource.data.professionalId == request.auth.uid
            || resource.data.clientId == request.auth.uid
            || isAdmin());
      allow delete: if isAdmin();
    }

    // Chats: SÓ os participantes da conversa. Antes qualquer usuário
    // autenticado conseguia ler todas as conversas e mensagens do app.
    // `resource == null` libera o getDoc do chat ainda inexistente,
    // que o app faz antes de criar a conversa.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        function inChat() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if inChat();
        allow create: if inChat() && request.auth.uid == request.resource.data.senderId;
        allow delete: if inChat() || isAdmin();
      }
    }

    // Admins: só o próprio admin pode ler seu doc (usado para verificar acesso ao painel)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // só via console do Firebase
    }

    // Offers: admin lê/escreve; clientes autenticados só leem
    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Config (plans, coupons, etc.): todos autenticados leem; só admin escreve
    match /config/{docId} {
      // Os cupons ficam de fora: lidos por qualquer conta, um cupom de 100%
      // virava Premium de graça para quem abrisse o console do navegador.
      // Quem valida cupom é a Cloud Function (redeemCoupon).
      allow read: if isAdmin() || (request.auth != null && docId != 'coupons');
      allow write: if isAdmin();
    }

    // Payments: usuário lê os próprios; só Cloud Functions escrevem (via admin SDK)
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Prontuário digital (medicalRecords/{petId}).
    // O documento-pai guarda `ownerId` e o acesso é do dono do animal ou
    // de um veterinário cadastrado. As subcoleções consultam o pai
    // porque uma listagem não pode depender do dado de cada doc.
    match /medicalRecords/{petId} {
      function recordAccess() {
        return request.auth != null && (
          !exists(/databases/$(database)/documents/medicalRecords/$(petId))
          || get(/databases/$(database)/documents/medicalRecords/$(petId))
               .data.get('ownerId', '') == request.auth.uid
          || isVetUser()
          || isAdmin()          // exclusão em cascata da conta
        );
      }

      allow read, write: if request.auth != null
        && (resource == null
            || resource.data.get('ownerId', '') == request.auth.uid
            || isVetUser() || isAdmin());

      match /entries/{entryId} { allow read, write: if recordAccess(); }
      match /weightLog/{logId} { allow read, write: if recordAccess(); }
    }

    // Default: deny everything else
  }
}
